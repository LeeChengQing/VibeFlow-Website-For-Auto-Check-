{
  "name": "vibeflow-auto-check",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:admin": "playwright test --config playwright.admin.config.ts",
    "test:perf": "npm run build && playwright test --config playwright.perf.config.ts",
    "test:performance-audit": "npm run build && playwright test --config playwright.audit.config.ts",
    "test:ui:prod": "npm run build && playwright test --config playwright.production.config.ts",
    "dev:admin": "node scripts/admin-preview.mjs",
    "keys:generate-intl": "node --env-file=.env.local scripts/generate-intl-keys.js",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "vite preview",
    "deploy:vinext": "vinext-cloudflare deploy"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/material": "7.3.11",
    "@paper-design/shaders-react": "0.0.81",
    "@supabase/supabase-js": "2.117.2",
    "@tailwindcss/postcss": "4.3.3",
    "@vinext/cloudflare": "^1.3.3",
    "framer-motion": "14.0.0",
    "gsap": "3.15.0",
    "html-to-image": "^1.11.13",
    "ldrs": "1.1.9",
    "lenis": "1.3.26",
    "lucide-react": "^1.51.0",
    "next": "16.3.8",
    "ogl": "^1.0.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "stripe": "23.0.0",
    "tailwindcss": "4.3.3",
    "vinext": "^1.4.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.12",
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitejs/plugin-rsc": "^0.5.39",
    "cf": "^1.0.0-beta.28",
    "esbuild": "0.28.2",
    "postcss": "^8.5.32",
    "supabase": "^2.120.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "^8.3.0",
    "vite-css-modules": "^1.16.1"
  },
  "type": "module"
}
