{
  "name": "vibeflow-auto-check",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:perf": "npm run build && playwright test --config playwright.perf.config.ts",
    "test:ui:prod": "npm run build && playwright test --config playwright.production.config.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@paper-design/shaders-react": "0.0.81",
    "@tailwindcss/postcss": "4.3.3",
    "framer-motion": "14.0.0",
    "gsap": "3.15.0",
    "html-to-image": "^1.11.13",
    "lenis": "1.3.26",
    "lucide-react": "^1.51.0",
    "next": "16.3.8",
    "ogl": "^1.0.11",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
