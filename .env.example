# LOCAL TESTING ONLY. Local APIs reject non-loopback hosts.
LOCAL_DEMO=true
LOCAL_ADMIN_PASSWORD=replace-with-your-own-local-password
# Manage the tutorial video HTTPS URL through the dashboard's Site Settings.

# Production admin dashboard. All four values are server-only.
# Password: 12–1,024 UTF-8 bytes. Session secret: 32 random bytes as 64 hex characters.
# Generate the session secret: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ADMIN_DASHBOARD_PASSWORD=
ADMIN_SESSION_SECRET=
SUPABASE_URL=https://qckpwckfukyurkobrsig.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Canonical checkout is disabled unless explicitly approved and enabled.
PUBLIC_SALES_ENABLED=false
# Disposable localhost tests only; production ignores this website switch.
COMMERCE_TEST_MODE=false

# Historical HitPay settlement ONLY; optional and never required for Stripe/ToyyibPay startup.
HITPAY_LEGACY_SETTLEMENT_ENABLED=false
# Separate credential for the existing legacy project; never reuse the canonical sales key.
HITPAY_LEGACY_SUPABASE_SERVICE_ROLE_KEY=
# Enable this existing signed callback only after separate historical-settlement approval.
HITPAY_WEBHOOK_SALT=
# Stable base64 encoding of exactly 32 bytes; generate a deployment-specific secret once.
LICENSE_KEY_ENCRYPTION_KEY=

# Stripe hosted checkout. Every value remains server-only.
# Restricted keys need Checkout Sessions write permission.
STRIPE_SECRET_KEY=
# Signing secret for /api/checkout/stripe/webhook; required before checkout is enabled.
STRIPE_WEBHOOK_SECRET=
# Public HTTPS origin, e.g. https://auto-check.example (no path).
# Optional in development on localhost; required on deployed hosts.
APP_URL=

# ToyyibPay bill creation and callback hash verification. Keep server-only.
TOYYIBPAY_SECRET_KEY=
TOYYIBPAY_CATEGORY_CODE=

# Explicit durable local settings/uploads preview. Ignored in production or remote hosts.
SITE_MANAGEMENT_LOCAL=false
# Optional local overrides (defaults to .local/site-management.sqlite and .local/site-assets).
SITE_MANAGEMENT_DB_PATH=
SITE_MANAGEMENT_ASSET_DIR=
